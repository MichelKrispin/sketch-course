---
layout: layouts/base.njk
title: Imitation Before Creation
---
<section class="hero"><div><p class="eyebrow">{{ 'A self-study course in monochrome drawing' | t }}</p><h1>{{ 'Imitation Before Creation' | t }}</h1><p class="intro">{{ 'Learn to see through someone else’s marks. Then make something of your own.' | t }}</p><a class="button" href="{{ '/orientation/' | localeUrl | url }}">{{ 'Begin with observation →' | t }}</a><p class="hero-meta">{{ '20 chapters · Graphite & pen · Printable A4 worksheets' | t }}</p></div><figure class="hero-image">{% set hero = 'met-341696' | reference %}<img src="{{ (hero.overview.path) | url }}" width="{{ hero.overview.width }}" height="{{ hero.overview.height }}" alt="{{ 'Flaxman’s flowing figure contours, the course’s first study in line economy.' | t }}"><figcaption>John Flaxman, <cite>Morning</cite>, 1792 · <a href="{{ hero.objectUrl }}">The Met, Public Domain</a></figcaption></figure></section>
<div class="rhythm" aria-label="{{ 'The chapter rhythm' | t }}">{% for step in ['Look','Map','Copy A','Copy B','Compare','Create','Self-check'] %}<div><span>{{ loop.index | pad }}</span>{{ step | t }}</div>{% endfor %}</div>
<section id="curriculum"><div class="section-heading"><h2>{{ 'A practice, one chapter at a time.' | t }}</h2><p>{{ 'Copy to understand. Compare to discriminate. Create to prove transfer.' | t }}</p></div>
<div class="progress-summary" hidden aria-live="polite"><span><span data-progress-count>0</span> {{ 'of 20 chapters practiced' | t }}</span><a data-next-chapter href="{{ '/chapter/01-line-quality/' | localeUrl | url }}">{{ 'Continue with your next chapter →' | t }}</a></div>
{% for part, chapters in collections.chapters | groupby('data.part') %}<h3 class="part-title">{{ 'Part' | t }} {{ part | t }}</h3><div class="course-grid">{% for chapter in chapters %}<article class="chapter-card"><span class="chapter-number">{{ chapter.data.number | pad }}</span><div><h3><a href="{{ chapter.url | localeUrl | url }}">{{ chapter.data.title | t }}</a></h3><p>{{ chapter.data.goal | t | sentence }}</p><div class="thumb-pair">{% for study in chapter.data.studies %}{% set ref = study.reference | reference %}{% set crop = ref | crop(study.crop) %}<img src="{{ (crop.path) | url }}" width="{{ crop.width }}" height="{{ crop.height }}" alt="{{ ref.artist }}: {{ study.use | t }}" loading="lazy">{% endfor %}</div><div class="card-meta"><span>{{ 'Difficulty' | t }} {{ chapter.data.difficulty }} / 5</span><span>{{ chapter.data.duration | t }}</span></div><label class="completion" hidden><input type="checkbox" value="{{ chapter.data.number }}">{{ 'Practiced chapter' | t }} {{ chapter.data.number }}</label></div></article>{% endfor %}</div>{% endfor %}
<p class="small">{{ 'Optional checkmarks stay in this browser. Keep your drawings to measure what you have learned.' | t }}</p></section>

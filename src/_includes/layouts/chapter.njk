---
layout: layouts/base.njk
---
<article class="chapter">
<section class="worksheet-page overview">
<p class="eyebrow">{{ part | t }} / {{ 'Chapter' | t }} {{ number | pad }}</p>
<h1 class="chapter-title">{{ title | t }}</h1>
<div class="chapter-meta"><span>{{ 'Difficulty' | t }} {{ difficulty }} / 5</span><span>{{ duration | t }}</span><span>{{ printPages }} {{ 'worksheet pages' | t }}</span><span>HB · 2B · {{ 'eraser' | t }}{% if number == 10 %} · {{ 'ruler' | t }}{% endif %}</span></div>
<div class="lesson-brief"><div><h2>{{ 'Focus' | t }}</h2><p>{{ goal | t | sentence }}</p></div><div><h2>{{ 'Final test' | t }}</h2><p>{{ creation | t | sentence }}</p></div><div><h2>{{ 'Evidence to look for' | t }}</h2><ul>{% for check in checks %}<li>{{ check | t | sentence }}</li>{% endfor %}</ul></div></div>
{% if number > 1 %}<aside class="retrieval-prompt"><p class="eyebrow">{{ 'Retrieve before you review · 60 seconds' | t }}</p><p>{{ 'Without reopening the previous chapter, sketch or write one decision you remember. Then check it and name what you missed.' | t }}</p></aside>{% endif %}
{% set cardMode = 'full' if number >= 19 else 'crop' %}<div class="reference-pair">{% for study in studies %}{% set letter = 'A' if loop.first else 'B' %}{% include 'components/reference-card.njk' %}{% endfor %}</div>{% set cardMode = 'crop' %}
<div class="two-col"><div><h2>01 / {{ 'Look' | t }} <small>3–5 min</small></h2><p>{{ look | t }}</p></div><div><h2>02 / {{ 'Map' | t }}</h2><p>{{ map | t }}</p></div></div>
{% include 'components/analysis.njk' %}
<div class="calibration"><span>{{ '50 mm · Print at 100%' | t }}</span></div>
</section>
{% for study in studies %}{% set letter = 'A' if loop.first else 'B' %}{% include 'components/copy-stage.njk' %}{% endfor %}
<section class="worksheet-page compare-stage"><p class="folio">{{ number | pad }} / {{ shortTitle | t }} · {{ 'Compare' | t }}</p><h2>05 / {{ 'Compare' | t }}</h2>{% include 'components/compare-table.njk' %}
<h3>{{ 'Targeted drill' | t }}</h3><p>{{ drill | t }}</p><p class="space-label">{{ 'Two trials' | t }} · 180 × 65 mm</p><div class="drawing-space drill-space split-space" aria-label="{{ 'Drawing area for two drill trials' | t }}"></div>
<h3>{{ 'Keep one decision' | t }}</h3><p>{{ 'Which choice will you carry into your own drawing? Name the mark and the job it does.' | t }}</p><div class="writing-lines"></div>
</section>
{% if number == 20 %}
<section class="worksheet-page"><p class="folio">20 / {{ 'Synthesis' | t }} · {{ 'Plan' | t }}</p><h2>06 / {{ 'Create — six thumbnails' | t }}</h2><p>{{ creation | t }}</p><p>{{ 'Try six arrangements. Change scale, overlap, empty space, and focal placement before choosing one.' | t }}</p><div class="thumbnail-grid">{% for i in [1,2,3,4,5,6] %}<div class="drawing-space"><span>{{ i }}</span></div>{% endfor %}</div><p class="space-label">{{ 'Each thumbnail' | t }}: 85 × 50 mm</p></section>
<section class="worksheet-page"><p class="folio">20 / {{ 'Synthesis' | t }} · {{ 'Construction & style' | t }}</p><h2>{{ 'Construction, then style' | t }}</h2><p>{{ 'Make two construction studies: environment first, figure masses second. Below, test the same junction with Edmonds’s sketchbook logic and Flaxman’s economical contour.' | t }}</p><div class="process-grid">{% for label in ['Construction 1', 'Construction 2', 'Style A — Edmonds', 'Style B — Flaxman'] %}<div><h3>{{ label | t }}</h3><div class="drawing-space process-space"></div></div>{% endfor %}</div><p class="space-label">{{ 'Each study' | t }}: 85 × 75 mm</p></section>
{% elif number == 19 %}
<section class="worksheet-page"><p class="folio">19 / {{ 'Grouped figures' | t }} · {{ 'Plan' | t }}</p><h2>06 / {{ 'Create — composition trials' | t }}</h2><p>{{ 'Make three 5 cm thumbnails from A and three from B. Change the gaps between figures in three original arrangements below.' | t }}</p><div class="thumbnail-grid composition-grid">{% for i in [1,2,3,4,5,6] %}<div class="drawing-space"><span>{{ i }}</span></div>{% endfor %}</div><p class="space-label">{{ 'Each reference thumbnail: 50 × 50 mm. Original arrangement trials below: 180 × 65 mm.' | t }}</p><div class="drawing-space drill-space"></div></section>
{% endif %}
<section class="worksheet-page creation-task"><p class="folio">{{ number | pad }} / {{ shortTitle | t }} · {{ 'Original drawing' | t }}</p><h2>06 / {% if number == 20 %}{{ 'Create — final drawing' | t }}{% else %}{{ 'Create' | t }}{% endif %}</h2><p>{{ creation | t }}</p><p>{{ transfer | t }}</p><p class="space-label">{{ 'Original study' | t }} · 180 × {% if number <= 10 %}110{% else %}165{% endif %} mm</p><div class="drawing-space {% if number <= 10 %}early-creation{% else %}final-space{% endif %}"></div>
{% if number <= 10 %}{% include 'components/self-check.njk' %}{% if checkpoint %}{% include 'components/checkpoint-print.njk' %}{% endif %}{% endif %}
</section>
{% if number > 10 %}<section class="worksheet-page review-page"><p class="folio">{{ number | pad }} / {{ shortTitle | t }} · {{ 'Review' | t }}</p>{% include 'components/self-check.njk' %}<h3>{% if number == 20 %}{{ 'Final self-critique · 150 words maximum' | t }}{% else %}{{ 'Revise the weakest structural decision' | t }}{% endif %}</h3><p>{{ 'Name one successful decision, one unresolved problem, and one specific next practice.' | t }}</p><div class="writing-lines tall"></div>{% if number == 20 %}<h3>{{ 'Return to your baseline' | t }}</h3><p>{{ 'Draw your original shoe, plant, or hand again for 15 minutes on a separate sheet. Put both drawings side by side. Compare proportion, line choice, value grouping, and unnecessary detail.' | t }}</p>{% else %}<p>{{ 'Redraw a small problem area from memory, then check it against your original study.' | t }}</p><div class="drawing-space drill-space"></div>{% endif %}{% if checkpoint %}{% include 'components/checkpoint-print.njk' %}{% endif %}</section>{% endif %}
{% if checkpoint %}<aside class="checkpoint screen-only"><p class="eyebrow">{{ 'Pause & retrieve · 20 minutes' | t }}</p><h2>{{ 'A review before the next chapter' | t }}</h2><p>{{ 'Choose an earlier creation task. Redraw it on a separate sheet without reopening the lesson, then compare both attempts using that chapter’s self-check. Record one change you can now make deliberately.' | t }}</p></aside>{% endif %}
{% if locale == 'en' %}<div class="screen-only lesson-notes"><h2>{{ 'The complete practice sequence' | t }}</h2>{{ content | safe }}</div>{% endif %}
<label class="completion chapter-completion screen-only" hidden><input type="checkbox" value="{{ number }}">{{ 'I completed the creation task and self-check.' | t }}</label>
<nav class="chapter-nav" aria-label="{{ 'Chapter navigation' | t }}">{% if previous %}<a href="{{ previous.url | localeUrl | url }}">← {{ previous.title | t }}</a>{% else %}<a href="{{ '/orientation/' | localeUrl | url }}">← {{ 'Before you begin' | t }}</a>{% endif %}<a href="{{ '/#curriculum' | localeUrl | url }}">{{ 'All chapters' | t }}</a>{% if next %}<a href="{{ next.url | localeUrl | url }}">{{ next.title | t }} →</a>{% else %}<a href="{{ '/orientation/#baseline' | localeUrl | url }}">{{ 'Return to your baseline →' | t }}</a>{% endif %}</nav>
</article>

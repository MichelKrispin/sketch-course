<!doctype html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | t }} · {{ 'Imitation Before Creation' | t }}</title>
<meta name="description" content="{{ (goal or 'A free, twenty-chapter course in monochrome drawing. Study historical drawings, compare their methods, and create your own.') | t }}">
<meta property="og:title" content="{{ title | t }}"><meta property="og:description" content="{{ (goal or 'Copy to understand. Compare to discriminate. Create to prove transfer.') | t }}"><meta property="og:type" content="website">
<link rel="stylesheet" href="{{ '/assets/css/screen.css' | url }}"><link rel="stylesheet" href="{{ '/assets/css/print.css' | url }}" media="print">
<script src="{{ '/assets/js/course.js' | url }}" defer></script>
</head>
<body>
<a class="skip-link" href="#main">{{ 'Skip to content' | t }}</a>
<header class="site-header"><a class="wordmark" href="{{ '/' | localeUrl | url }}">{{ 'Imitation Before Creation' | t }}</a><nav aria-label="{{ 'Main' | t }}"><a href="{{ '/orientation/' | localeUrl | url }}">{{ 'Before you begin' | t }}</a><a href="{{ '/#curriculum' | localeUrl | url }}">{{ 'The course' | t }}</a><a href="{{ '/sources/' | localeUrl | url }}">{{ 'Sources' | t }}</a></nav><a class="language-toggle" href="{{ page.url | alternateUrl | url }}" lang="{{ 'en' if locale == 'de' else 'de' }}" hreflang="{{ 'en' if locale == 'de' else 'de' }}">{{ 'English' if locale == 'de' else 'Deutsch' }}</a><button class="print-button" hidden type="button">{{ 'Print / Save PDF' | t }}</button></header>
<main id="main">{{ content | safe }}</main>
<footer class="site-footer"><span>{{ 'Observe carefully. Draw deliberately.' | t }}</span><a href="{{ '/' | localeUrl | url }}">{{ 'Imitation Before Creation' | t }}</a><span>{{ 'Graphite & optional pen · No account needed' | t }}</span></footer>
</body></html>

<div class="self-check"><h2>07 / {{ 'Self-check' | t }}</h2><p>{{ 'Check structure first, style second, detail last. Choose one rating for each criterion.' | t }}</p>
<table class="self-check-table"><thead><tr><th scope="col">{{ 'Criterion' | t }}</th><th scope="col">{{ 'Holds' | t }}</th><th scope="col">{{ 'Revise' | t }}</th><th scope="col">{{ 'Try again' | t }}</th></tr></thead><tbody>{% for check in checks %}{% set checkIndex = loop.index %}<tr><th scope="row">{{ check | t | sentence }}</th>{% for rating in ['Holds', 'Revise', 'Try again'] %}<td><label><input type="radio" name="check-{{ number }}-{{ checkIndex }}"><span class="sr-only">{{ check | t | sentence }} — {{ rating | t }}</span></label></td>{% endfor %}</tr>{% endfor %}</tbody></table>
</div>

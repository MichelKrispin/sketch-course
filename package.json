{
  "name": "imitation-before-creation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && node scripts/clean.mjs && eleventy && node scripts/verify-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "qa": "node scripts/browser-qa.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "cheerio": "^1.1.2",
    "playwright": "^1.55.1",
    "sharp": "^0.35.4"
  }
}
